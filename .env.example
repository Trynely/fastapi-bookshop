# Шаблон окружения: cp .env.example .env и заполни секреты.
# Реальный .env в git не попадает (.gitignore) и в образ не копируется (.dockerignore).

FASTAPI__APP__ENV = dev

# ---
# app

FASTAPI__APP__NAME = bookshop
FASTAPI__APP__HOST = http://127.0.0.1:8000/
FASTAPI__APP__TEMPLATES_DIR = app/templates

# ---
# api

FASTAPI__API__PREFIX = /api

# ---
# db

FASTAPI__DB__URL = postgresql+asyncpg://postgres:postgres@postgres:5432/bookshop
FASTAPI__TEST_DB__URL = postgresql+asyncpg://postgres:postgres@postgres:5432/test_bookshop
FASTAPI__DB__ECHO = false
FASTAPI__DB__ECHO_POOL = false
FASTAPI__DB__POOL_SIZE = 10
FASTAPI__DB__MAX_OVERFLOW = 10
FASTAPI__DB__LIMIT = 50

POSTGRES_USER = postgres
POSTGRES_PASSWORD = postgres
POSTGRES_DB = bookshop

FASTAPI__AUTH__MAX_AUTH_USER_SESSIONS = 3

# ---
# queues

FASTAPI__REDIS__URL = redis://redis:6379/0
FASTAPI__CELERY__URL = redis://redis:6379/1
FASTAPI__RABBITMQ__URL = amqp://guest:guest@rabbitmq:5672//

# ---
# stripe

STRIPE_PUBLISHABLE_KEY = pk_test_your-publishable-key
STRIPE_SECRET_KEY = sk_test_your-secret-key
FASTAPI__STRIPE__SECRET_KEY = sk_test_your-secret-key
FASTAPI__STRIPE__WEBHOOK_SECRET = whsec_your-webhook-secret

# ---
# otp

FASTAPI__OTP__TTL = 300
FASTAPI__OTP__KEY = otp:
FASTAPI__OTP__LENGTH = 6

# ---
# jwt (ключи лежат в ./cert, пробрасываются в контейнер через volume)

FASTAPI__JWT__PRIVATE_KEY_PATH = /cert/jwt-private.pem
FASTAPI__JWT__PUBLIC_KEY_PATH = /cert/jwt-public.pem
FASTAPI__JWT__ALGORITHM = RS256
FASTAPI__JWT__ACCESS_TOKEN_EXP_MINUTE = 10
FASTAPI__JWT__REFRESH_TOKEN_EXP_DAYS = 7

FASTAPI__JWT__TYPE_FIELD = type
FASTAPI__JWT__ACCESS_TOKEN_FIELD = access_token
FASTAPI__JWT__REFRESH_TOKEN_FIELD = refresh_token

# ---
# smtp

FASTAPI__SMTP__DSN = smtp://user@example.com:app-password@smtp.gmail.com:587
FASTAPI__SMTP__DEFAULT_EMAIL = user@example.com
FASTAPI__SMTP__NO_REPLY_EMAIL = noreply@example.com

# ---
# clickhouse

CLICKHOUSE_HOST = clickhouse
CLICKHOUSE_PORT = 8123
CLICKHOUSE_DB = default

# ---
# ollama

FASTAPI__OLLAMA__URL = http://host.docker.internal:11434

# ---
# qdrant

FASTAPI__QDRANT__URL = http://qdrant:6333

# ---
# elasticsearch

FASTAPI__ELASTICSEARCH__URL = http://elasticsearch:9200

# ---
# secret key

FASTAPI__APP__SECRET_KEY = generate-me-openssl-rand-base64-32

# ---
# oauth google

FASTAPI__OAUTH_GOOGLE__CLIENT_ID = your-client-id.apps.googleusercontent.com
FASTAPI__OAUTH_GOOGLE__CLIENT_SECRET = your-client-secret
FASTAPI__OAUTH_GOOGLE__SERVER_METADATA = https://accounts.google.com/.well-known/openid-configuration

# ---
# llm

# big chat model
FASTAPI__LLM__BASE_URL = https://api.openai.com/v1
FASTAPI__LLM__API_KEY = your-api-key
FASTAPI__LLM__CHAT_MODEL = gpt-4.1

# small models (intent router + chitchat/offtopic replies)
FASTAPI__LLM__ROUTER_BASE_URL = http://host.docker.internal:11434/v1
FASTAPI__LLM__ROUTER_API_KEY = ollama
FASTAPI__LLM__ROUTER_MODEL = llama3.1:8b
FASTAPI__LLM__SMALL_CHAT_MODEL = llama3.1:8b
