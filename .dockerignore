# ========================
# Git
# ========================
.git
.gitignore
.github

# ========================
# Docker
# ========================
# Исключаем файлы оркестрации, они не нужны внутри самого контейнера
docker-compose*.yml
.dockerignore

# ========================
# Python & Poetry
# ========================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
poetry.toml

# ========================
# Виртуальные окружения
# ========================
.venv
venv/
env/
ENV/

# ========================
# Секреты и локальные конфиги
# ========================
# КРИТИЧЕСКИ ВАЖНО: исключаем локальные .env файлы!
.env
.env.*
*.pem
*.key
# Исключаем папку с локальными сертификатами, так как в docker-compose 
# ты все равно пробрасываешь её через volume (./cert:/cert:ro)
cert/

# ========================
# IDE и редакторы
# ========================
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ========================
# Сборка, тесты, логи
# ========================
build/
dist/
*.egg-info/
.coverage
htmlcov/
.tox/
*.log
logs/
*.sqlite3